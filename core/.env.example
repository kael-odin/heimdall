# ---------------------------------------------------------------
# Heimdall 配置示例（复制为 .env 后修改；.env 已被 gitignore）
#
# 这份文件的 LLM_* 部分可以直接在控制台「设置 → 模型服务」里改：
# 保存后立即生效（引擎每次调用重读配置），无需重启。
# 也可以设 HEIMDALL_ENV_FILE 把配置指向别处（容器挂载 / 多套配置切换）。
# ---------------------------------------------------------------

# ---- 引擎（HTTP API / 控制台）----
# 注意：本节的 HEIMDALL_HOST / HEIMDALL_TOKEN / HEIMDALL_ALLOWED_HOSTS / HEIMDALL_DATA_DIR
# 引擎只从**进程环境变量**读（启动命令之前 export，或写进 docker-compose 的 environment），
# 写在 .env 里不会生效 —— 尤其 HEIMDALL_TOKEN：写在这里引擎照样不鉴权。
# 下面的 LLM_* 与阈值才由引擎从 .env 读取。
HEIMDALL_HOST=127.0.0.1
# 引擎 Token：保护 /api/* 与 /px/* 的口令（不是模型 Key，可留空）
# HEIMDALL_TOKEN=change-me
# 允许代理的额外域名（默认只允许 workspace 下已存在的 host）
# HEIMDALL_ALLOWED_HOSTS=example.com,www.example.com
# 产物目录（默认 core/；可指向仓库外的独立磁盘）
# HEIMDALL_DATA_DIR=D:\heimdall-data

# ---- LLM（三要素 + 协议）----
HEIMDALL_LLM=1
LLM_BASE_URL=https://your-relay.example.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=glm-5.3-flash
LLM_MODEL_FAST=deepseek-flash
# chat（OpenAI 兼容 /chat/completions，默认）| responses（/responses）| anthropic（/messages）
LLM_PROTOCOL=chat
# 可选：请求超时与网络层重试
# LLM_TIMEOUT_MS=180000
# LLM_MAX_RETRIES=3

# ---- 还原度 / AI 校准阈值 ----
# FIXME 静态差异占比低于此值时跳过 AI 校准
# FIXUP_MIN_STATIC=0.002
# 静态差异占全部差异比低于此值时跳过（主要是动画噪声）
# FIXUP_MIN_REFINABLE=0.3
