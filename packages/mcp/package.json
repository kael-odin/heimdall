{
  "name": "@heimdall/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Heimdall MCP v2 server (Bifröst): tools, resources and prompts generated from the core capability registry",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "heimdall-mcp": "bin/heimdall-mcp.mjs"
  },
