"""Bind completed local gate inputs to the staged raw Git blobs."""
import argparse
import datetime
import hashlib
import json
from pathlib import Path
import subprocess
import sys

parser = argparse.ArgumentParser()
parser.add_argument('--batch', action='append', required=True)
args = parser.parse_args()
repo = Path(__file__).resolve().parents[4]
out = Path(__file__).parent / ('frozen-index-' + datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ'))
out.mkdir()
checks, manifests = [], []
for value in args.batch:
    folder = Path(value).resolve()
    batch = json.loads((folder / 'batch.json').read_text(encoding='utf-8'))
    before = json.loads((folder / 'inputs-before.json').read_text(encoding='utf-8'))
    after = json.loads((folder / 'inputs-after.json').read_text(encoding='utf-8'))
    accepted = batch['status'] == 'completed' and batch['passed'] is True and batch.get('changedInputs') == [] and before == after
    checks.append({'batch': str(folder), 'accepted': accepted, 'inputCount': len(before)})
    manifests.append(before)
reference = manifests[0]
consistent = all(value == reference for value in manifests)
rows = []
for path, expected in reference.items():
    result = subprocess.run(['git', 'cat-file', 'blob', ':' + path], cwd=repo, capture_output=True)
    current = hashlib.sha256((repo / path).read_bytes()).hexdigest()
    staged = hashlib.sha256(result.stdout).hexdigest() if result.returncode == 0 else None
    rows.append({'path': path, 'expectedSha256': expected, 'indexSha256': staged, 'worktreeSha256': current,
        'exactMatch': staged == expected == current, 'indexReadExitCode': result.returncode})
report = {'schemaVersion': 1, 'at': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'batches': checks,
    'allBatchInputsEqual': consistent, 'passed': all(x['accepted'] for x in checks) and consistent and all(x['exactMatch'] for x in rows),
    'files': rows}
(out / 'result.json').write_text(json.dumps(report, indent=2) + '\n', encoding='utf-8')
print(json.dumps({'out': str(out), 'passed': report['passed'], 'inputCount': len(rows),
    'mismatches': [row['path'] for row in rows if not row['exactMatch']]}))
sys.exit(0 if report['passed'] else 1)
