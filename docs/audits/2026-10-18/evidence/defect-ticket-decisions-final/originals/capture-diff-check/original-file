"""Retain complete diff diagnostics without flooding the operator output."""
import datetime
import json
from pathlib import Path
import subprocess
import sys

repo = Path(__file__).resolve().parents[4]
out = Path(__file__).parent / ('diff-check-' + datetime.datetime.now(datetime.timezone.utc).strftime('%Y%m%dT%H%M%S.%fZ'))
out.mkdir()
result = subprocess.run(['git', 'diff', '--cached', '--check'], cwd=repo, capture_output=True)
(out / 'stdout.log').write_bytes(result.stdout)
(out / 'stderr.log').write_bytes(result.stderr)
(out / 'result.json').write_text(json.dumps({'exitCode': result.returncode, 'argv': ['git', 'diff', '--cached', '--check'],
    'cwd': str(repo)}, indent=2) + '\n', encoding='utf-8')
diagnostics = [line for line in result.stdout.decode('utf-8', errors='replace').splitlines()
    if line.startswith('docs/') or line.startswith('core/') or line.startswith('console/')]
print(json.dumps({'out': str(out), 'exitCode': result.returncode, 'diagnosticCount': len(diagnostics), 'diagnostics': diagnostics[:30]}))
sys.exit(result.returncode)
