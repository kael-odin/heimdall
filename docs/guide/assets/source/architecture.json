  "cards": [
    {
      "dot": "cyan",
      "title": "三层怎么分",
      "items": [
        "core/ 是仪器：确定性搬运，零外部服务依赖",
        "engine-server.mjs 是调度台：排队、记工、拉子进程，并同源托管控制台",
        "console/ 是控制室：只通过 REST + SSE 与引擎对话"
      ]
    },
    {
      "dot": "emerald",
      "title": "产物与存储",
      "items": [
        "workspace/ 放逐页产物，deliverable/ 放可部署包",
        "CAS 内容寻址 + 硬链接：同一文件只占一份磁盘",
        "两者都不进 git，可用 HEIMDALL_DATA_DIR 移出仓库"
      ]
    },
    {
      "dot": "rose",
      "title": "边界",
      "items": [
        "默认只监听 127.0.0.1，HEIMDALL_HOST 可改",
        "登录态与原始抓包绝不走 /static 静态通道",
        "大模型可选；Key 只落本地、永不回显"
      ]
    }
  ]
