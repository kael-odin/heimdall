# dependencies
node_modules/
.pnpm-store/
# root has no dependencies; pnpm regenerates this empty file on every run
/pnpm-lock.yaml

# build output
dist/
build/
.vite/
coverage/
*.tsbuildinfo

# runtime data (never commit site artifacts)
core/workspace/
core/_maintenance/
core/trash/
core/assets-cas/
core/jobs.db*
# AI 接入层运行时状态（引擎地址、门面任务快照）；不入库
core/agent/
core/*.db-shm
core/*.db-wal
core/deliverable/
core/deliver-plan.json
core/acceptance/
data/
logs/
*.log

# secrets
.env
.env.*
!.env.example
*.pem
*.key

# local knowledge graph and one-off spikes (not part of the product)
graphify-out/
core/spikes/

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# playwright
playwright-report/
test-results/
.playwright-cli/

# 运行期盘点产物（引擎会在内存里现算；CLI storage 默认写这里）
core/storage.json

# Impeccable 设计流程产物：surface brief 与 design.json 入库，评审截图/草稿不入库
.impeccable/review/
.impeccable/mocks/
.impeccable/build/
.impeccable/config.local.json

# local assistant/debug configuration
.claude/

# Playwright MCP 工具的截图/快照（调试产物，不入库）
.playwright-mcp/

# archify 的工作目录：图源另存到 docs/guide/assets/source/ 并入库，其余是可重建的产物与证据
.archify/
