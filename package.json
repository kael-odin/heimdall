{
  "name": "heimdall",
  "version": "2.0.0-dev",
  "private": true,
  "license": "MIT",
  "description": "Heimdall — site cloning, fidelity verification and SEO audit workbench",
  "type": "module",
  "packageManager": "pnpm@11.28.10",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "pnpm -C core test",
    "test:full": "pnpm -C core test:full",
    "test:fast": "pnpm -C core test:fast",
    "test:acceptance": "pnpm -C core test:acceptance",
    "check": "pnpm -C core lint && pnpm -C core check:docs && pnpm -C core check:frozen && pnpm -C console build && pnpm -C core test:fast && pnpm -C packages/mcp test && pnpm -C packages/mcp check:plugin && pnpm skills:check && pnpm run audit && pnpm acceptance:demo:smoke",
    "lint": "pnpm -C core lint",
    "build": "pnpm -C console build",
    "docs:links": "pnpm -C core check:docs",
    "dev:core": "pnpm -C core dev",
    "dev:console": "pnpm -C console dev",
    "smoke": "pnpm -C core smoke",
    "acceptance": "node core/src/acceptance/cli.mjs",
    "acceptance:demo": "node core/scripts/start-acceptance-demo.mjs",
    "acceptance:demo:smoke": "node core/scripts/smoke-acceptance-demo-console.mjs",
    "acceptance:benchmark": "node core/scripts/benchmark-acceptance.mjs",
    "acceptance:smoke": "node core/scripts/smoke-acceptance-console.mjs",
    "acceptance:spec:benchmark": "node core/scripts/benchmark-acceptance-spec.mjs",
    "acceptance:spec:smoke": "node core/scripts/smoke-acceptance-spec-console.mjs",
    "acceptance:comparison:benchmark": "node core/scripts/benchmark-acceptance-comparison.mjs",
    "acceptance:comparison:smoke": "node core/scripts/smoke-acceptance-comparison-console.mjs",
    "acceptance:catalog:smoke": "node core/scripts/smoke-acceptance-catalog-console.mjs",
    "acceptance:catalog:migration:smoke": "node core/scripts/smoke-acceptance-catalog-migration.mjs",
    "acceptance:catalog:maintenance": "node core/src/acceptance/catalog-maintenance-cli.mjs",
    "acceptance:baseline:smoke": "node core/scripts/smoke-acceptance-baseline-console.mjs",
    "acceptance:managed:prepare:smoke": "node core/scripts/smoke-acceptance-managed-preparation.mjs",
    "acceptance:managed:read:smoke": "node core/scripts/smoke-acceptance-managed-reading.mjs",
    "acceptance:owned:recovery:smoke": "node core/scripts/smoke-acceptance-owned-recovery.mjs",
    "acceptance:managed:execute:smoke": "node core/scripts/smoke-acceptance-managed-execution.mjs",
    "acceptance:execution:ui:smoke": "node core/scripts/smoke-acceptance-execution-ui.mjs",
    "acceptance:browser:source:smoke": "node core/scripts/smoke-acceptance-browser-source.mjs",
    "acceptance:browser:read:smoke": "node core/scripts/smoke-acceptance-browser-reading.mjs",
    "acceptance:browser:bindings:smoke": "node core/scripts/smoke-acceptance-browser-bindings.mjs",
    "acceptance:browser:bindings:ui:smoke": "node core/scripts/smoke-acceptance-browser-bindings-console.mjs",
    "acceptance:browser:bindings:v4:smoke": "node core/scripts/smoke-acceptance-browser-bindings-console.mjs --migrate-catalog",
    "acceptance:browser:candidates:ui:smoke": "node core/scripts/smoke-acceptance-browser-candidates-console.mjs",
    "acceptance:browser:execute:smoke": "node core/scripts/smoke-acceptance-browser-execution-console.mjs",
    "acceptance:browser:resolution:smoke": "node core/scripts/smoke-acceptance-browser-resolution-console.mjs",
    "acceptance:defect:tickets:smoke": "node core/scripts/smoke-acceptance-defect-tickets-console.mjs",
    "acceptance:defect:decisions:smoke": "node core/scripts/smoke-acceptance-defect-ticket-decisions-console.mjs",
    "acceptance:defect:decisions:verify": "node core/scripts/verify-acceptance-defect-ticket-decisions-console.mjs",
    "qa:benchmark": "node core/scripts/benchmark-qa.mjs",
    "mcp:build": "pnpm -C packages/mcp build:plugin",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "audit": "pnpm -C core audit --prod --audit-level=moderate --registry=https://registry.npmjs.org && pnpm -C console audit --audit-level=moderate --registry=https://registry.npmjs.org && pnpm -C packages/mcp audit --audit-level=moderate --registry=https://registry.npmjs.org"
  },
  "bin": {
    "heimdall": "bin/heimdall.mjs"
  }
}
