    "acceptance:comparison:smoke": "node core/scripts/smoke-acceptance-comparison-console.mjs",
    "acceptance:catalog:smoke": "node core/scripts/smoke-acceptance-catalog-console.mjs",
    "acceptance:catalog:migration:smoke": "node core/scripts/smoke-acceptance-catalog-migration.mjs",
    "acceptance:baseline:smoke": "node core/scripts/smoke-acceptance-baseline-console.mjs",
    "acceptance:managed:prepare:smoke": "node core/scripts/smoke-acceptance-managed-preparation.mjs",
    "acceptance:managed:read:smoke": "node core/scripts/smoke-acceptance-managed-reading.mjs",
    "acceptance:owned:recovery:smoke": "node core/scripts/smoke-acceptance-owned-recovery.mjs",
    "acceptance:managed:execute:smoke": "node core/scripts/smoke-acceptance-managed-execution.mjs",
