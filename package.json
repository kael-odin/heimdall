{
  "name": "heimdall",
  "version": "2.0.0-dev",
  "private": true,
  "description": "Heimdall — site cloning, fidelity verification and SEO audit workbench",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "pnpm -C core test",
